<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The system distnoted (github.com/pearOS-bsd/d, darwin/distnoted): the job of the Mac's /System/Library/LaunchDaemons/com.apple.distnoted.xpc.daemon.plist
     (argument "daemon", services com.apple.distributed_notifications@1v3 for system processes and @0v3 for the agents of the sessions).
     The Mac runs it as _distnote; pearOS has no such account, so root.  The launchd of d reads it from /usr/libexec/pearos/jobs. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.distnoted.xpc.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/pearos/distnoted</string>
		<string>daemon</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.distributed_notifications@0v3</key>
		<true/>
		<key>com.apple.distributed_notifications@1v3</key>
		<true/>
	</dict>
</dict>
</plist>
