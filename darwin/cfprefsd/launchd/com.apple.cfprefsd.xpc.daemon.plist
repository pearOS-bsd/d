<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The system cfprefsd (github.com/pearOS-bsd/d, darwin/cfprefsd): the job of the Mac's /System/Library/LaunchDaemons/com.apple.cfprefsd.xpc.daemon.plist
     (argument "daemon", service com.apple.cfprefsd.daemon, root, started at the first look-up).  The launchd of d reads it from /usr/libexec/pearos/jobs. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.cfprefsd.xpc.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/pearos/cfprefsd</string>
		<string>daemon</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.cfprefsd.daemon</key>
		<true/>
	</dict>
	<key>EnableTransactions</key>
	<true/>
</dict>
</plist>
